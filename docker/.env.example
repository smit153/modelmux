# Copy to docker/.env (git-ignored) and fill in. Never commit real keys.
# Comma-separated inbound API keys, each at least 32 characters, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MODELMUX_API_KEYS=
# Optional hardening knobs (see docs/CONFIGURATION.md):
# MODELMUX_MAX_CONCURRENT_PROCESSES=2
# MODELMUX_LOG_LEVEL=INFO
